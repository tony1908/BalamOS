#!/usr/bin/env bash
set -euo pipefail

export DISPLAY="${DISPLAY:-:1}"
capture_dir=/config/orbit/captures

die() {
  help
  printf '%s\n' "orbitctl: $1" >&2
  exit 2
}

help() {
  printf '%s\n' \
    'Usage: orbitctl <group> <action> [args...]' \
    '' \
    'Commands:' \
    '  orbitctl screen capture' \
    '  orbitctl mouse click <x> <y>' \
    '  orbitctl mouse move <x> <y>' \
    '  orbitctl keyboard type <text>' \
    '  orbitctl keyboard key <key>' \
    '  orbitctl browser open <url>' \
    '  orbitctl process list' \
    '  orbitctl system status' \
    '' \
    'Use orbitctl <group> --help for group-specific help.'
}

group_help() {
  case "$1" in
    screen) printf '%s\n' 'Usage: orbitctl screen capture' ;;
    mouse) printf '%s\n' 'Usage: orbitctl mouse {click|move} <x> <y>' ;;
    keyboard) printf '%s\n' 'Usage: orbitctl keyboard {type <text>|key <key>}' ;;
    browser) printf '%s\n' 'Usage: orbitctl browser open <url>' ;;
    process) printf '%s\n' 'Usage: orbitctl process list' ;;
    system) printf '%s\n' 'Usage: orbitctl system status' ;;
    *) return 1 ;;
  esac
}

describe() {
  printf '%s\n' '{"name":"orbitctl","version":"0.1.0","commands":[{"group":"screen","action":"capture","usage":"orbitctl screen capture"},{"group":"mouse","action":"click","usage":"orbitctl mouse click <x> <y>"},{"group":"mouse","action":"move","usage":"orbitctl mouse move <x> <y>"},{"group":"keyboard","action":"type","usage":"orbitctl keyboard type <text>"},{"group":"keyboard","action":"key","usage":"orbitctl keyboard key <key>"},{"group":"browser","action":"open","usage":"orbitctl browser open <url>"},{"group":"process","action":"list","usage":"orbitctl process list"},{"group":"system","action":"status","usage":"orbitctl system status"}]}'
}

if [[ $# -eq 1 && $1 == --help ]]; then
  help
  exit 0
fi
if [[ $# -eq 1 && $1 == describe ]]; then
  describe
  exit 0
fi
if [[ $# -eq 2 && $2 == --help ]]; then
  group_help "$1" || die "unsupported command"
  exit 0
fi
[[ $# -ge 2 ]] || die "expected a command and action"
command_name=$1
action=$2
shift 2

case "$command_name:$action" in
  screen:capture)
    [[ $# -eq 0 ]] || die "screen capture takes no arguments"
    mkdir -p "$capture_dir"
    output="$capture_dir/screen-$(date +%s%N).png"
    scrot "$output"
    printf '%s\n' "$output"
    ;;
  mouse:click)
    [[ $# -eq 2 && $1 =~ ^[0-9]+$ && $2 =~ ^[0-9]+$ ]] || die "mouse click expects numeric x y"
    xdotool mousemove "$1" "$2" click 1
    ;;
  mouse:move)
    [[ $# -eq 2 && $1 =~ ^[0-9]+$ && $2 =~ ^[0-9]+$ ]] || die "mouse move expects numeric x y"
    xdotool mousemove "$1" "$2"
    ;;
  keyboard:type)
    [[ $# -eq 1 ]] || die "keyboard type expects one text argument"
    xdotool type --clearmodifiers -- "$1"
    ;;
  keyboard:key)
    [[ $# -eq 1 && $1 =~ ^[A-Za-z0-9_+-]+$ ]] || die "keyboard key expects one safe key name"
    xdotool key --clearmodifiers "$1"
    ;;
  browser:open)
    [[ $# -eq 1 && $1 =~ ^https?://[^[:space:]]+$ ]] || die "browser open expects an http(s) URL"
    nohup xdg-open "$1" >/dev/null 2>&1 &
    ;;
  process:list)
    [[ $# -eq 0 ]] || die "process list takes no arguments"
    ps -eo pid,user,stat,comm,args
    ;;
  system:status)
    [[ $# -eq 0 ]] || die "system status takes no arguments"
    jq -n --arg uptime "$(uptime -p)" --arg load "$(cut -d ' ' -f 1-3 /proc/loadavg)" \
      '{uptime: $uptime, load: $load}'
    ;;
  *)
    die "unsupported command"
    ;;
esac

#!/usr/bin/env bash
# Installs selected Orbit catalog apps into the running workspace.
# Called by the daemon after container start, AS ROOT: the container runs with
# no_new_privileges, so `sudo` cannot escalate — the daemon execs this via
# `docker exec -u root`, which starts as root directly.
#   orbit-install-apps --profile <observe|workspace|full_control> <app-id>...
# Idempotent and best-effort: each app guards itself; failures are logged, never fatal.
set -u
CIRCLE_INSTALL_FAILED=0

PROFILE=""
APPS=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --profile) PROFILE="${2:-}"; shift 2 ;;
    *) APPS+=("$1"); shift ;;
  esac
done

log() { printf 'orbit-install-apps: %s\n' "$*"; }
have_net() { [ "$PROFILE" != "observe" ]; } # ponytail: Observe runs with no container network
# Root writes directly; keep a sudo fallback for anyone running this by hand as abc.
SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="sudo"
# The desktop runs as abc(1000); files root creates in abc's home must be handed back.
own_abc() { [ "$(id -u)" -eq 0 ] && chown -R abc:abc "$@" 2>/dev/null || true; }

install_hedera_readonly() {
  local dir=/opt/balamos/hedera
  local bin=/usr/local/bin/balamos-hedera-readonly
  if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
    log "Hedera readonly helper: skipped; node and npm are required"
    return 0
  fi
  if [ "$PROFILE" = "observe" ]; then
    log "Hedera readonly helper: skipped; observe profile has no network"
    return 0
  fi
  if [ -d /opt/balamos/hedera-src/src ]; then
    rm -rf "$dir"
    mkdir -p "$dir"
    cp -R /opt/balamos/hedera-src/. "$dir/"
  else
    log "Hedera readonly helper: canonical package payload is missing"
    return 1
  fi
  if ! npm install --prefix "$dir" --omit=dev --ignore-scripts >/dev/null 2>&1; then
    log "Hedera readonly helper: dependency installation failed"
    return 1
  fi
  cat >"$bin" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
exec node /opt/balamos/hedera/src/cli.mjs "$@"
  SH
  chmod 0755 "$bin"
  cat > /usr/local/bin/balamos-hedera-transfer <<'SH'
#!/usr/bin/env bash
set -euo pipefail
exec node /opt/balamos/hedera/src/agent-cli.mjs "$@"
SH
  chmod 0755 /usr/local/bin/balamos-hedera-transfer
  "$bin" ready >/dev/null || { log "Hedera readonly helper: readiness failed"; return 1; }
  log "Hedera readonly helper: installed in $dir"
}

